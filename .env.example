# Copy to .env and fill in your values before running:
#   cp .env.example .env
# Then edit .env with your actual values.
# DATABASE_URL, CELERY_BROKER_URL, CELERY_RESULT_BACKEND are set automatically
# by docker-compose and do NOT need to be added here.

POSTGRES_PASSWORD=your_postgres_password_here

# Generate with: openssl rand -base64 32
MASTER_SECRET=your_random_32plus_char_secret_here
SUPERADMIN_PASSWORD=your_superadmin_password_here
JWT_SECRET=your_jwt_secret_here

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
